# Example settings. Make your own copy with:
#
#     ./scripts/init-env.sh
#
# then edit .env. It is git-ignored: never commit real credentials.
# Values already set in your shell take precedence over .env.

# --- Postgres -------------------------------------------------------------
# docker-compose.yml creates the database with these, and the app connects with
# them. They only take effect when the database volume is first created; after
# changing them, recreate it with: ./scripts/down.sh --wipe && ./scripts/up.sh
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=offerzen-db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Or give the full URL instead (overrides the POSTGRES_* values above):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/offerzen-db

# --- Valkey (cache) -------------------------------------------------------
VALKEY_HOST=localhost
VALKEY_PORT=6380
# Or the full URL (overrides VALKEY_HOST / VALKEY_PORT):
# VALKEY_URL=valkey://localhost:6380/0

# --- API ------------------------------------------------------------------
API_PORT=8000
# Where the scripts send requests (default: http://127.0.0.1:$API_PORT)
# API_URL=http://127.0.0.1:8000

# --- Tuning (defaults shown; uncomment to change) ----------------------------
# ORDER_PENDING_TTL=30          # seconds an order_ref claim is held in Valkey
# ORDER_CACHE_TTL=604800        # seconds a created order stays cached (7 days)
# VALKEY_TIMEOUT=1              # seconds before a Valkey call gives up
# CACHE_SYNC_INTERVAL=5         # seconds between Postgres -> Valkey syncs
# STOCK_WORKER_POLL=1           # seconds between stock worker polls
# EVENT_STREAM_POLL=1           # seconds between event stream polls
# GRACEFUL_SHUTDOWN_SECONDS=3   # seconds to wait for open streams on shutdown
